# Mínimo 32 caracteres aleatorios; la app aborta el arranque si no se cumple.
FLASK_SECRET_KEY=cambia-esta-clave-de-sesion-flask

# Local / Docker Compose
NUTRIKIDS_API_BASE_URL=http://127.0.0.1:8000

# Railway (red privada + fallback público)
# NUTRIKIDS_API_INTERNAL_URL=http://nutrikids-sitioweb.railway.internal:8000
# NUTRIKIDS_API_PUBLIC_URL=https://nutrikids-sitioweb.up.railway.app

LARAVEL_PUBLIC_URL=http://127.0.0.1:8080
FLASK_PORT=5000

# Recuadro de credenciales de demo en /login. Sólo demos locales.
FLASK_SHOW_DEMO_CREDENTIALS=false
