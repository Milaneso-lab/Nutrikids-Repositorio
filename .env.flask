# Renombra o copia a `web1_flask/.env` según tu flujo.
# Flask 3.x — capa padres (sesiones en cookie; datos vía FastAPI + conexión opcional a PG).

# Mínimo 32 caracteres aleatorios; la app aborta el arranque si no se cumple.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=CAMBIAR
NUTRIKIDS_API_BASE_URL=http://127.0.0.1:8000
LARAVEL_PUBLIC_URL=http://127.0.0.1:8080
FLASK_PORT=5000

# Recuadro de credenciales de demo en /login. Sólo demos locales.
FLASK_SHOW_DEMO_CREDENTIALS=false

# Misma base PostgreSQL que Laravel (sólo para /health/db; los datos se leen vía API).
# Sustituye CAMBIAR por el valor de POSTGRES_PASSWORD del .env raíz.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://nutrikids_user:CAMBIAR@127.0.0.1:5432/nutrikids
