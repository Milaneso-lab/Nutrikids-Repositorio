# Copia este archivo a `.env` en la raíz del proyecto Laravel (NutriKids/) para Docker.
# Versiones: Laravel ^12, PHP 8.2

APP_NAME=NutriKids
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# En Docker Compose se fuerza DB_HOST=postgres. Fuera de Docker usa 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nutrikids
DB_USERNAME=nutrikids_user
# Debe coincidir con POSTGRES_PASSWORD del .env raíz que consume docker-compose.
DB_PASSWORD=cambia-esta-contrasena

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Dentro de Docker, `docker-compose.yml` sobrescribe DB_HOST=postgres y credenciales.
# API interna (PHP → FastAPI)
NUTRIKIDS_API_BASE_URL=http://fastapi:8000
NUTRIKIDS_API_TIMEOUT=10

# Enlaces mostrados al navegador del usuario (fuera de Docker)
FLASK_PUBLIC_URL=http://localhost:5000
