# NutriKids — FastAPI: API REST compartida (auth, foros, pacientes, etc.)
FROM python:3.10-slim

WORKDIR /app

COPY fastapi/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY fastapi/ /app/

COPY docker/entrypoint-fastapi.sh /usr/local/bin/entrypoint-fastapi.sh
RUN chmod +x /usr/local/bin/entrypoint-fastapi.sh

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/entrypoint-fastapi.sh"]
