# NutriKids — Flask (padres): frontend y proxy a FastAPI
# Variables Railway recomendadas:
#   NUTRIKIDS_API_INTERNAL_URL=http://nutrikids-sitioweb.railway.internal:8000
#   NUTRIKIDS_API_PUBLIC_URL=https://nutrikids-sitioweb.up.railway.app  (fallback)
FROM python:3.10-slim

WORKDIR /app

COPY flask/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY flask/ /app/

EXPOSE 5000

CMD ["python", "app.py"]
