APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nutrikids
DB_USERNAME=nutrikids_user
# Debe coincidir con POSTGRES_PASSWORD (más abajo). docker-compose la inyecta al contenedor.
DB_PASSWORD=cambia-esta-contrasena

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

FLASK_PUBLIC_URL=http://localhost:5000
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NUTRIKIDS_API_BASE_URL=http://fastapi:8000
NUTRIKIDS_API_TIMEOUT=10

# Correo para restablecimiento de contraseña (FastAPI → app móvil)
# log = código visible en `docker logs nutrikids_fastapi` (desarrollo)
# smtp = envío real (Gmail, Outlook, etc.) — ver fastapi/.env.example
NUTRIKIDS_MAIL_MAILER=log
NUTRIKIDS_MAIL_SMTP_HOST=
NUTRIKIDS_MAIL_SMTP_PORT=587
NUTRIKIDS_MAIL_SMTP_USER=
NUTRIKIDS_MAIL_SMTP_PASSWORD=
NUTRIKIDS_MAIL_FROM_ADDRESS=noreply@nutrikids.com
NUTRIKIDS_MAIL_FROM_NAME=NutriKids

# Redirigir rutas públicas de padres hacia Flask (interfaces padre). Dejar vacío para servir desde Laravel.
FLASK_PUBLIC_URL=http://127.0.0.1:5000

# Muestra el recuadro con credenciales de demo en /login. Sólo para demostraciones
# locales: publica usuarios y contraseñas de los seeders. Nunca activar en producción.
FLASK_SHOW_DEMO_CREDENTIALS=false

# --------------------------------------------------------------------------
# Docker Compose — servicios de infraestructura (requerido para `docker compose up`)
# --------------------------------------------------------------------------
# PostgreSQL: única fuente de datos del proyecto. Consumido por Laravel,
# FastAPI (SQLAlchemy) y Flask (health check). Usa una contraseña fuerte fuera de local.
POSTGRES_DB=nutrikids
POSTGRES_USER=nutrikids_user
POSTGRES_PASSWORD=cambia-esta-contrasena

# Clave de sesión de Flask (mínimo 32 caracteres aleatorios; Flask aborta si es más corta).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=cambia-esta-clave-de-sesion-flask

# --------------------------------------------------------------------------
# Administrador de emergencia (opcional, sólo entornos no productivos)
# --------------------------------------------------------------------------
# Sólo se necesitan para `php artisan admin:crear-temporal` o
# `php artisan db:seed --class=AdminTemporalSeeder`, que restablecen el acceso
# al panel si se pierde. Deja las variables vacías y retíralas tras usarlas.
ADMIN_TEMPORAL_EMAIL=
ADMIN_TEMPORAL_PASSWORD=

# pgAdmin — consola de administración web de PostgreSQL (http://localhost:5050).
# El servidor "NutriKids PostgreSQL" se precarga desde docker/pgadmin/servers.json;
# la contraseña de la base se solicita en el primer connect y NO se guarda en el repo.
PGADMIN_DEFAULT_EMAIL=admin@nutrikids.com
PGADMIN_DEFAULT_PASSWORD=cambia-esta-contrasena-pgadmin
PGADMIN_PORT=5050
