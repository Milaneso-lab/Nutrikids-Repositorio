# NutriKids FastAPI — variables de entorno (05_Seguridad.md)
# Copiar a fastapi/.env — NUNCA commitear valores reales de producción

# --- Aplicación ---
NUTRIKIDS_APP_NAME=NutriKids API
NUTRIKIDS_ENVIRONMENT=development

# --- JWT / Tokens (rotar en producción) ---
NUTRIKIDS_SECRET_KEY=genera-un-secreto-largo-aleatorio-min-32-chars
NUTRIKIDS_ALGORITHM=HS256
NUTRIKIDS_ACCESS_TOKEN_MINUTES=15
NUTRIKIDS_REFRESH_TOKEN_DAYS_WEB=30
NUTRIKIDS_REFRESH_TOKEN_DAYS_MOBILE=90

# --- Base de datos (solo red interna en producción) ---
NUTRIKIDS_DATABASE_URL=postgresql+psycopg2://nutrikids_user:CAMBIAR@localhost:5432/nutrikids

# --- Redis (rate limiting distribuido + denylist JWT) ---
# En Docker: redis://redis:6379/0
NUTRIKIDS_REDIS_URL=

# --- CORS (orígenes permitidos, separados por coma) ---
NUTRIKIDS_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080

# --- Contraseñas (bcrypt rounds >= 12) ---
NUTRIKIDS_BCRYPT_ROUNDS=12
NUTRIKIDS_PASSWORD_MIN_LENGTH=8
NUTRIKIDS_PASSWORD_REQUIRE_UPPER=true
NUTRIKIDS_PASSWORD_REQUIRE_LOWER=true
NUTRIKIDS_PASSWORD_REQUIRE_DIGIT=true

# --- Bloqueo de cuenta / rate limits ---
NUTRIKIDS_LOGIN_MAX_ATTEMPTS=5
NUTRIKIDS_LOGIN_LOCKOUT_MINUTES=15
NUTRIKIDS_RATE_LIMIT_LOGIN_PER_MIN=5
NUTRIKIDS_RATE_LIMIT_REGISTER_PER_MIN=3
NUTRIKIDS_RATE_LIMIT_CONTACT_PER_MIN=3
NUTRIKIDS_RATE_LIMIT_GLOBAL_PER_MIN=120
NUTRIKIDS_PASSWORD_RESET_MINUTES=30

# --- Auditoría ---
NUTRIKIDS_AUDIT_LOG_ENABLED=true

# --- Correo (restablecimiento de contraseña) ---
# mailer=log imprime el código en logs de Docker (desarrollo)
# mailer=smtp envía correo real (Gmail, Outlook, SendGrid, etc.)
NUTRIKIDS_MAIL_MAILER=log
NUTRIKIDS_MAIL_SMTP_HOST=
NUTRIKIDS_MAIL_SMTP_PORT=587
NUTRIKIDS_MAIL_SMTP_USER=
NUTRIKIDS_MAIL_SMTP_PASSWORD=
NUTRIKIDS_MAIL_FROM_ADDRESS=noreply@nutrikids.com
NUTRIKIDS_MAIL_FROM_NAME=NutriKids
NUTRIKIDS_MAIL_USE_TLS=true
NUTRIKIDS_MAIL_RESET_DEEP_LINK_BASE=nutrikids://reset-password

# Ejemplo Gmail (requiere contraseña de aplicación):
# NUTRIKIDS_MAIL_MAILER=smtp
# NUTRIKIDS_MAIL_SMTP_HOST=smtp.gmail.com
# NUTRIKIDS_MAIL_SMTP_PORT=587
# NUTRIKIDS_MAIL_SMTP_USER=tu@gmail.com
# NUTRIKIDS_MAIL_SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Docker: no usar create_all (Alembic + Laravel migraciones) ---
NUTRIKIDS_SKIP_CREATE_ALL=1

# --- Seeds de desarrollo (admin123, demo@nutrikids.app, etc.) ---
# En production/staging se ignoran automáticamente. En development: true por defecto.
NUTRIKIDS_ENABLE_DEV_SEED=true
